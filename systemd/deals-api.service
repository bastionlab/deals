[Unit]
Description=deals API (for the dashboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/deals/deals.env
WorkingDirectory=/opt/deals
ExecStart=/opt/deals/venv/bin/uvicorn app.api:app --host 0.0.0.0 --port 8090 --log-level warning
Restart=always
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/deals

[Install]
WantedBy=multi-user.target
